{
  "name": "client",
  "version": "1.0.0",
  "description": "FraudGuard Desktop Client",
  "main": "main.js",
  "scripts": {
    "dev:react": "cd react-ui && npm run dev",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "start": "concurrently -k \"npm run dev:react\" \"npm run dev:electron\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0"
  }
}
